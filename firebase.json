{
  "hosting": {
    "public": "frontend",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "accelerometer=(),camera=(),geolocation=(self),gyroscope=(),magnetometer=(),microphone=(),payment=(),usb=()" },
          { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'unsafe-inline'; connect-src 'self' https://*.run.app https://valleycaregroup.co.uk https://www.valleycaregroup.co.uk; frame-src https://www.google.com https://maps.google.com https://www.google.com/maps https://www.youtube.com;" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/assets/js/runtime-config.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/assets/js/config.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/admin.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/admin",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/login",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
        ]
      }
    ],
    "rewrites": [
      { "source": "/admin", "destination": "/admin.html" },
      { "source": "/login", "destination": "/admin.html" },
      { "source": "/homes/:page", "destination": "/homes/:page.html" }
    ]
  }
}
